# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API in the Supabase dashboard).
# .env.local is already gitignored by Next.js, so your real keys never
# get committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
